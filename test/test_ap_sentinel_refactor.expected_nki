                if offset_0 >= 0 and offset_0 < 128 and (offset_0 + 128 > 128) and (offset_1 >= 0) and (offset_1 + 64 <= 64):
                    nisa.dma_copy(dst=nki_return_buf[offset_0:128, offset_1:offset_1 + 64], src=_nki_sbuf_2[0:128 - offset_0, 0:64])
                if offset_0 >= 0 and offset_0 < 128 and (offset_0 + 128 > 128) and (offset_1 >= 0) and (offset_1 < 64) and (offset_1 + 64 > 64):
                    nisa.dma_copy(dst=nki_return_buf[offset_0:128, offset_1:64], src=_nki_sbuf_2[0:128 - offset_0, 0:64 - offset_1])
    # src[test_ap_sentinel_refactor.py:N]: def indirect_gather(
    # src[test_ap_sentinel_refactor.py:N]:     x: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N]:     idx: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    return nki_return_buf

def indirect_gather(x: torch.Tensor, idx: torch.Tensor, *, _launcher=_default_nki_launcher):
    # src[test_ap_sentinel_refactor.py:N]: B = idx.size(0)
    B = idx.size(0)
    # src[test_ap_sentinel_refactor.py:N]: D = x.size(1)
    D = x.size(1)
    # src[test_ap_sentinel_refactor.py:N]: out = torch.empty([B, D], dtype=x.dtype, device=x.device)
    out = torch.empty([B, D], dtype=x.dtype, device=x.device)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_d in hl.tile([B, D]):
    # src[test_ap_sentinel_refactor.py:N]:     flat_idx = idx[tile_b] % x.size(0)
    # src[test_ap_sentinel_refactor.py:N]:     out[tile_b, tile_d] = x[flat_idx, tile_d]
    out = _launcher(_helion_indirect_gather, (1,), idx, x)
    # src[test_ap_sentinel_refactor.py:N]: return out
    return out
