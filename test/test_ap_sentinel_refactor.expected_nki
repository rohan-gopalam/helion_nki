            nisa.dma_copy(dst=nki_return_buf.ap(pattern=[[4, 4], [1, 4]], scalar_offset=_dyn_counter, indirect_dim=0), src=_nki_sbuf_2, oob_mode=nisa.oob_mode.skip)
