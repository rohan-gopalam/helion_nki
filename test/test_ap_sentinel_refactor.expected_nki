            indices_1 = nl.ndarray([1, 64], nl.int32, buffer=nl.sbuf)
            nisa.iota(dst=indices_1, pattern=[[1, 64]], offset=offset_1, channel_multiplier=0)
            # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_q, tile_d in hl.tile(
            # src[test_ap_sentinel_refactor.py:N]:     [B, L, D], block_size=[1, None, None]
            # src[test_ap_sentinel_refactor.py:N]: ):
            # src[test_ap_sentinel_refactor.py:N-N]: ...
            for offset_2 in nl.affine_range(0, 128, 128):
                # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_q, tile_d in hl.tile(
                # src[test_ap_sentinel_refactor.py:N]:     [B, L, D], block_size=[1, None, None]
                # src[test_ap_sentinel_refactor.py:N]: ):
                indices_2 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
