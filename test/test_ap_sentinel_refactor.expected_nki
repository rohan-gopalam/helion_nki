        nisa.memset(_nki_sbuf_1, value=0)
        if 0 >= 0 and 0 + 1 <= 1:
            nisa.dma_copy(dst=_nki_sbuf_1, src=bound[0:1, 0:0 + 1])
        # src[test_ap_sentinel_refactor.py:N]: for tile_n in hl.tile(bound[0], block_size=bs):
