from __future__ import annotations

import torch
import nki
import nki.language as nl
import nki.isa as nisa
from helion.runtime import default_nki_launcher as _default_nki_launcher

@nki.jit
def _helion_flat_3d_copy(x):
    # src[test_ap_sentinel_refactor.py:N]: def flat_3d_copy(x: torch.Tensor) -> torch.Tensor:
    # src[test_ap_sentinel_refactor.py:N]:     B, M, K = x.shape
    # src[test_ap_sentinel_refactor.py:N]:     out = torch.empty_like(x)
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    x = x.reshape([4 * 128, 128])
