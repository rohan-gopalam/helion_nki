                        nisa.dma_copy(dst=nki_return_buf[_nki_sbuf_1 + offset_1:64, offset_2:offset_2 + 128], src=_nki_sbuf_2[0:64 - (_nki_sbuf_1 + offset_1), 0:128])
                    if _nki_sbuf_1 + offset_1 >= 0 and _nki_sbuf_1 + offset_1 < 64 and (_nki_sbuf_1 + offset_1 + 64 > 64) and (offset_2 >= 0) and (offset_2 < 128) and (offset_2 + 128 > 128):
                        nisa.dma_copy(dst=nki_return_buf[_nki_sbuf_1 + offset_1:64, offset_2:128], src=_nki_sbuf_2[0:64 - (_nki_sbuf_1 + offset_1), 0:128 - offset_2])
    # src[test_ap_sentinel_refactor.py:N]: def jagged_copy(
    # src[test_ap_sentinel_refactor.py:N]:     x: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N]:     offsets: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    return nki_return_buf

def jagged_copy(x: torch.Tensor, offsets: torch.Tensor, *, _launcher=_default_nki_launcher):
    # src[test_ap_sentinel_refactor.py:N]: B = offsets.size(0) - 1
    B = offsets.size(0) - 1
    # src[test_ap_sentinel_refactor.py:N]: L, D = x.shape
    L, D = x.shape
    # src[test_ap_sentinel_refactor.py:N]: out = torch.empty_like(x)
    out = torch.empty_like(x)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_q, tile_d in hl.tile(
    # src[test_ap_sentinel_refactor.py:N]:     [B, L, D], block_size=[1, None, None]
    # src[test_ap_sentinel_refactor.py:N]: ):
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    out = _launcher(_helion_jagged_copy, (1,), offsets, x)
    # src[test_ap_sentinel_refactor.py:N]: return out
    return out

