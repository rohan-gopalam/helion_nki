from __future__ import annotations

import torch
import nki
import nki.language as nl
import nki.isa as nisa
from helion.runtime import default_nki_launcher as _default_nki_launcher

@nki.jit
def _helion_embedding(x_flat, weight):
    # src[test_ap_sentinel_refactor.py:N]: def embedding(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
    # src[test_ap_sentinel_refactor.py:N]:     x_flat = x.reshape(-1)
    # src[test_ap_sentinel_refactor.py:N]:     _, embedding_dim = weight.size()
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    x_flat = x_flat.reshape([1, 8192])
    weight = weight.reshape([16, 128])
    # src[test_ap_sentinel_refactor.py:N]: out[tile_b, tile_e] = weight[x_flat[tile_b], tile_e]
    nki_return_buf = nl.ndarray([8192, 128], dtype=nl.float32, buffer=nl.shared_hbm)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_e in hl.tile([x_flat.size(0), embedding_dim]):
    # src[test_ap_sentinel_refactor.py:N]:     out[tile_b, tile_e] = weight[x_flat[tile_b], tile_e]
    for offset_0 in nl.affine_range(0, 8192, 128):
        # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_e in hl.tile([x_flat.size(0), embedding_dim]):
        indices_0 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
        nisa.iota(dst=indices_0, pattern=[[1, 128]], offset=offset_0, channel_multiplier=0)
        # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_e in hl.tile([x_flat.size(0), embedding_dim]):
        # src[test_ap_sentinel_refactor.py:N]:     out[tile_b, tile_e] = weight[x_flat[tile_b], tile_e]
        for offset_1 in nl.affine_range(0, 128, 128):
            # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_e in hl.tile([x_flat.size(0), embedding_dim]):
            indices_1 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
            nisa.iota(dst=indices_1, pattern=[[1, 128]], offset=offset_1, channel_multiplier=0)
            # src[test_ap_sentinel_refactor.py:N]: out[tile_b, tile_e] = weight[x_flat[tile_b], tile_e]
            _nki_sbuf_1 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
            nisa.memset(_nki_sbuf_1, value=0)
            if offset_0 >= 0 and offset_0 + 128 <= 8192:
                nisa.dma_copy(dst=_nki_sbuf_1, src=x_flat[0:1, offset_0:offset_0 + 128])
            _ig_cast_in = nl.ndarray([1, 128], nl.float32, buffer=nl.sbuf)
            nisa.activation(dst=_ig_cast_in, op=nl.copy, data=_nki_sbuf_1)
            _ig_tr_psum = nl.ndarray([128, 1], nl.float32, buffer=nl.psum)
            nisa.nc_transpose(dst=_ig_tr_psum, data=_ig_cast_in)
            _ig_tr_sbuf = nl.ndarray([128, 1], nl.uint32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_ig_tr_sbuf, data=_ig_tr_psum, op0=nl.add, operand0=0.0)
            _nki_sbuf_2 = nl.ndarray([128, 128], nl.float32, buffer=nl.sbuf)
            nisa.memset(_nki_sbuf_2, value=0)
            _ig_flat_vec = nl.ndarray([128, 1], nl.uint32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_ig_flat_vec, data=_ig_tr_sbuf, op0=nl.multiply, operand0=128, op1=None)
            nisa.tensor_scalar(dst=_ig_flat_vec, data=_ig_flat_vec, op0=nl.add, operand0=offset_1, op1=None)
            if offset_1 >= 0 and offset_1 + 128 <= 128:
                nisa.dma_copy(dst=_nki_sbuf_2, src=weight.reshape([16 * 128, 1]).ap(pattern=[[1, 128], [1, 128]], vector_offset=_ig_flat_vec, indirect_dim=0), oob_mode=nisa.oob_mode.skip)
            if offset_0 >= 0 and offset_0 + 128 <= 8192 and (offset_1 >= 0) and (offset_1 + 128 <= 128):
                nisa.dma_copy(dst=nki_return_buf[offset_0:offset_0 + 128, offset_1:offset_1 + 128], src=_nki_sbuf_2)
            else:
                if offset_0 >= 0 and offset_0 + 128 <= 8192 and (offset_1 >= 0) and (offset_1 < 128) and (offset_1 + 128 > 128):
                    nisa.dma_copy(dst=nki_return_buf[offset_0:offset_0 + 128, offset_1:128], src=_nki_sbuf_2[0:128, 0:128 - offset_1])
                if offset_0 >= 0 and offset_0 < 8192 and (offset_0 + 128 > 8192) and (offset_1 >= 0) and (offset_1 + 128 <= 128):
                    nisa.dma_copy(dst=nki_return_buf[offset_0:8192, offset_1:offset_1 + 128], src=_nki_sbuf_2[0:8192 - offset_0, 0:128])
                if offset_0 >= 0 and offset_0 < 8192 and (offset_0 + 128 > 8192) and (offset_1 >= 0) and (offset_1 < 128) and (offset_1 + 128 > 128):
                    nisa.dma_copy(dst=nki_return_buf[offset_0:8192, offset_1:128], src=_nki_sbuf_2[0:8192 - offset_0, 0:128 - offset_1])
    # src[test_ap_sentinel_refactor.py:N]: def embedding(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
    # src[test_ap_sentinel_refactor.py:N]:     x_flat = x.reshape(-1)
    # src[test_ap_sentinel_refactor.py:N]:     _, embedding_dim = weight.size()
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    return nki_return_buf

def embedding(x: torch.Tensor, weight: torch.Tensor, *, _launcher=_default_nki_launcher):
    # src[test_ap_sentinel_refactor.py:N]: x_flat = x.reshape(-1)
    x_flat = x.reshape(-1)
    # src[test_ap_sentinel_refactor.py:N]: _, embedding_dim = weight.size()
    _, embedding_dim = weight.size()
    # src[test_ap_sentinel_refactor.py:N]: out = torch.empty(
    # src[test_ap_sentinel_refactor.py:N]:     [x_flat.size(0), embedding_dim],
    # src[test_ap_sentinel_refactor.py:N]:     dtype=weight.dtype,
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    out = torch.empty([x_flat.size(0), embedding_dim], dtype=weight.dtype, device=weight.device)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_e in hl.tile([x_flat.size(0), embedding_dim]):
    # src[test_ap_sentinel_refactor.py:N]:     out[tile_b, tile_e] = weight[x_flat[tile_b], tile_e]
    out = _launcher(_helion_embedding, (1,), x_flat, weight)
    # src[test_ap_sentinel_refactor.py:N]: return out.view(*x.size(), embedding_dim)
    return out.view(*x.size(), embedding_dim)

