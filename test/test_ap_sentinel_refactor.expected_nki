    # src[test_ap_sentinel_refactor.py:N]: def jagged_store(
    # src[test_ap_sentinel_refactor.py:N]:     src: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N]:     out: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    return nki_return_buf

def jagged_store(src: torch.Tensor, out: torch.Tensor, offsets: torch.Tensor, *, _launcher=_default_nki_launcher):
    # src[test_ap_sentinel_refactor.py:N]: B = offsets.size(0) - 1
