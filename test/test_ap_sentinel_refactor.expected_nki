    idx = idx.reshape([1, 128])
    x = x.reshape([64, 64])
    # src[test_ap_sentinel_refactor.py:N]: out[tile_b, tile_d] = x[flat_idx, tile_d]
    nki_return_buf = nl.ndarray([128, 64], dtype=nl.float32, buffer=nl.shared_hbm)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_d in hl.tile([B, D]):
    # src[test_ap_sentinel_refactor.py:N]:     flat_idx = idx[tile_b] % x.size(0)
    # src[test_ap_sentinel_refactor.py:N]:     out[tile_b, tile_d] = x[flat_idx, tile_d]
    for offset_0 in nl.affine_range(0, 128, 128):
        # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_d in hl.tile([B, D]):
        indices_0 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
        nisa.iota(dst=indices_0, pattern=[[1, 128]], offset=offset_0, channel_multiplier=0)
        # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_d in hl.tile([B, D]):
        # src[test_ap_sentinel_refactor.py:N]:     flat_idx = idx[tile_b] % x.size(0)
        # src[test_ap_sentinel_refactor.py:N]:     out[tile_b, tile_d] = x[flat_idx, tile_d]
        for offset_1 in nl.affine_range(0, 64, 64):
            # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_d in hl.tile([B, D]):
            indices_1 = nl.ndarray([1, 64], nl.int32, buffer=nl.sbuf)
            nisa.iota(dst=indices_1, pattern=[[1, 64]], offset=offset_1, channel_multiplier=0)
            # src[test_ap_sentinel_refactor.py:N]: flat_idx = idx[tile_b] % x.size(0)
            _nki_sbuf_1 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
            nisa.memset(_nki_sbuf_1, value=0)
            if offset_0 >= 0 and offset_0 + 128 <= 128:
                nisa.dma_copy(dst=_nki_sbuf_1, src=idx[0:1, offset_0:offset_0 + 128])
            v_0 = 64
            _nki_floordiv_f32 = nl.ndarray([1, 128], nl.float32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_nki_floordiv_f32, data=_nki_sbuf_1, op0=nl.multiply, operand0=0.015625)
            _nki_floordiv_i32 = nl.floor(_nki_floordiv_f32, dtype=nl.int32)
            _nki_mod_prod = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_nki_mod_prod, data=_nki_floordiv_i32, op0=nl.multiply, operand0=64)
            _nki_mod_i32 = nl.ndarray([1, 128], nl.int32, buffer=nl.sbuf)
            nisa.tensor_tensor(dst=_nki_mod_i32, data1=_nki_sbuf_1, data2=_nki_mod_prod, op=nl.subtract)
            # src[test_ap_sentinel_refactor.py:N]: out[tile_b, tile_d] = x[flat_idx, tile_d]
            _ig_cast_in = nl.ndarray([1, 128], nl.float32, buffer=nl.sbuf)
            nisa.activation(dst=_ig_cast_in, op=nl.copy, data=_nki_mod_i32)
            _ig_tr_psum = nl.ndarray([128, 1], nl.float32, buffer=nl.psum)
            nisa.nc_transpose(dst=_ig_tr_psum, data=_ig_cast_in)
            _ig_tr_sbuf = nl.ndarray([128, 1], nl.uint32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_ig_tr_sbuf, data=_ig_tr_psum, op0=nl.add, operand0=0.0)
            _nki_sbuf_2 = nl.ndarray([128, 64], nl.float32, buffer=nl.sbuf)
            nisa.memset(_nki_sbuf_2, value=0)
            _ig_flat_vec = nl.ndarray([128, 1], nl.uint32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_ig_flat_vec, data=_ig_tr_sbuf, op0=nl.multiply, operand0=64, op1=None)
            nisa.tensor_scalar(dst=_ig_flat_vec, data=_ig_flat_vec, op0=nl.add, operand0=offset_1, op1=None)
            if offset_1 >= 0 and offset_1 + 64 <= 64:
                nisa.dma_copy(dst=_nki_sbuf_2, src=x.reshape([64 * 64, 1]).ap(pattern=[[1, 128], [1, 64]], vector_offset=_ig_flat_vec, indirect_dim=0), oob_mode=nisa.oob_mode.skip)
            if offset_0 >= 0 and offset_0 + 128 <= 128 and (offset_1 >= 0) and (offset_1 + 64 <= 64):
                nisa.dma_copy(dst=nki_return_buf[offset_0:offset_0 + 128, offset_1:offset_1 + 64], src=_nki_sbuf_2)
            else:
