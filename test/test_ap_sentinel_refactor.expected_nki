        nisa.memset(_dyn_counter_f, value=-4.0)
        for offset_0 in nl.dynamic_range(0, _dyn_bnd_reg, 4):
            nisa.tensor_scalar(dst=_dyn_counter, data=_dyn_counter, op0=nl.add, operand0=4)
            nisa.tensor_scalar(dst=_dyn_counter_f, data=_dyn_counter_f, op0=nl.add, operand0=4.0)
            indices_0 = nl.ndarray([1, 4], nl.int32, buffer=nl.sbuf)
            nisa.iota(dst=indices_0, pattern=[[1, 4]], offset=0, channel_multiplier=0)
