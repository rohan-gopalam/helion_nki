    nki_return_buf = nl.ndarray([4 * 32, 64], dtype=nl.float32, buffer=nl.shared_hbm)
    # src[test_ap_sentinel_refactor.py:N]: for tile_h, tile_s in hl.tile([H, S]):
    # src[test_ap_sentinel_refactor.py:N]:     i_h = tile_h.id
    # src[test_ap_sentinel_refactor.py:N]:     out[i_h, tile_s, :] = w[tile_s, i_h, :]
    for offset_0 in nl.affine_range(0, 4, 1):
        for offset_1 in nl.affine_range(0, 32, 32):
            # src[test_ap_sentinel_refactor.py:N]: for tile_h, tile_s in hl.tile([H, S]):
            indices_1 = nl.ndarray([1, 32], nl.int32, buffer=nl.sbuf)
            nisa.iota(dst=indices_1, pattern=[[1, 32]], offset=offset_1, channel_multiplier=0)
            # src[test_ap_sentinel_refactor.py:N]: i_h = tile_h.id
            tile_id = offset_0 // 1
            # src[test_ap_sentinel_refactor.py:N]: out[i_h, tile_s, :] = w[tile_s, i_h, :]
            _sg_iota = nl.ndarray([1, 32], nl.int32, buffer=nl.sbuf)
            nisa.iota(dst=_sg_iota, pattern=[[1, 32]], offset=offset_1, channel_multiplier=0)
            _sg_scaled = nl.ndarray([1, 32], nl.int32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_sg_scaled, data=_sg_iota, op0=nl.multiply, operand0=4, op1=None)
            _sg_row = nl.ndarray([1, 32], nl.int32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_sg_row, data=_sg_scaled, op0=nl.add, operand0=offset_0, op1=None)
            _ig_cast_in = nl.ndarray([1, 32], nl.float32, buffer=nl.sbuf)
            nisa.activation(dst=_ig_cast_in, op=nl.copy, data=_sg_row)
            _ig_tr_psum = nl.ndarray([32, 1], nl.float32, buffer=nl.psum)
            nisa.nc_transpose(dst=_ig_tr_psum, data=_ig_cast_in)
            _ig_tr_sbuf = nl.ndarray([32, 1], nl.uint32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_ig_tr_sbuf, data=_ig_tr_psum, op0=nl.add, operand0=0.0)
            _nki_sbuf_1 = nl.ndarray([32, 64], nl.float32, buffer=nl.sbuf)
            nisa.memset(_nki_sbuf_1, value=0)
            _ig_flat_vec = nl.ndarray([32, 1], nl.uint32, buffer=nl.sbuf)
            nisa.tensor_scalar(dst=_ig_flat_vec, data=_ig_tr_sbuf, op0=nl.multiply, operand0=64, op1=None)
            if 0 >= 0 and 64 <= 64:
                nisa.dma_copy(dst=_nki_sbuf_1, src=w.reshape([128 * 64, 1]).ap(pattern=[[1, 32], [1, 64]], vector_offset=_ig_flat_vec, indirect_dim=0), oob_mode=nisa.oob_mode.skip)
            if offset_0 * 32 + offset_1 >= 0 and offset_0 * 32 + offset_1 + 32 <= 128 and (0 >= 0) and (0 + 64 <= 64):
                nisa.dma_copy(dst=nki_return_buf[offset_0 * 32 + offset_1:offset_0 * 32 + offset_1 + 32, 0:0 + 64], src=_nki_sbuf_1)
            else:
                if offset_0 * 32 + offset_1 >= 0 and offset_0 * 32 + offset_1 + 32 <= 128 and (0 >= 0) and (0 < 64) and (0 + 64 > 64):
                    nisa.dma_copy(dst=nki_return_buf[offset_0 * 32 + offset_1:offset_0 * 32 + offset_1 + 32, 0:64], src=_nki_sbuf_1[0:32, 0:64 - 0])
                if offset_0 * 32 + offset_1 >= 0 and offset_0 * 32 + offset_1 < 128 and (offset_0 * 32 + offset_1 + 32 > 128) and (0 >= 0) and (0 + 64 <= 64):
                    nisa.dma_copy(dst=nki_return_buf[offset_0 * 32 + offset_1:128, 0:0 + 64], src=_nki_sbuf_1[0:128 - (offset_0 * 32 + offset_1), 0:64])
                if offset_0 * 32 + offset_1 >= 0 and offset_0 * 32 + offset_1 < 128 and (offset_0 * 32 + offset_1 + 32 > 128) and (0 >= 0) and (0 < 64) and (0 + 64 > 64):
                    nisa.dma_copy(dst=nki_return_buf[offset_0 * 32 + offset_1:128, 0:64], src=_nki_sbuf_1[0:128 - (offset_0 * 32 + offset_1), 0:64 - 0])
    # src[test_ap_sentinel_refactor.py:N]: def strided_gather(w: torch.Tensor, nheads: int) -> torch.Tensor:
    # src[test_ap_sentinel_refactor.py:N]:     S, H, D = w.shape
    # src[test_ap_sentinel_refactor.py:N]:     H = hl.specialize(nheads)
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    return nki_return_buf

def strided_gather(w: torch.Tensor, nheads: int, *, _launcher=_default_nki_launcher):
    # src[test_ap_sentinel_refactor.py:N]: S, H, D = w.shape
    S, H, D = w.shape
    # src[test_ap_sentinel_refactor.py:N]: H = hl.specialize(nheads)
    H = 4
    # src[test_ap_sentinel_refactor.py:N]: out = torch.empty(H, S, D, device=w.device, dtype=w.dtype)
    out = torch.empty(H, S, D, device=w.device, dtype=w.dtype)
    # src[test_ap_sentinel_refactor.py:N]: for tile_h, tile_s in hl.tile([H, S]):
    # src[test_ap_sentinel_refactor.py:N]:     i_h = tile_h.id
    # src[test_ap_sentinel_refactor.py:N]:     out[i_h, tile_s, :] = w[tile_s, i_h, :]
    out = _launcher(_helion_strided_gather, (1,), w).reshape([4, 32, 64])
    # src[test_ap_sentinel_refactor.py:N]: return out
    return out

