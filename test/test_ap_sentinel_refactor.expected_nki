from __future__ import annotations

import torch
import nki
import nki.language as nl
import nki.isa as nisa
from helion.runtime import default_nki_launcher as _default_nki_launcher

@nki.jit
def _helion_jagged_3d_load(offsets, x):
    # src[test_ap_sentinel_refactor.py:N]: def jagged_3d_load(
    # src[test_ap_sentinel_refactor.py:N]:     x: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N]:     offsets: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    offsets = offsets.reshape([1, 5])
    x = x.reshape([100 * 2, 16])
    # src[test_ap_sentinel_refactor.py:N]: out[tile_q.index + starts, i_h, :] = x[tile_q.index + starts, i_h, :]
    nki_return_buf = nl.ndarray([100 * 2, 16], dtype=nl.float32, buffer=nl.shared_hbm)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_h, tile_q in hl.tile(
    # src[test_ap_sentinel_refactor.py:N]:     [num_batches, nheads, L], block_size=[1, 1, None]
    # src[test_ap_sentinel_refactor.py:N]: ):
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    for offset_0 in nl.affine_range(0, 4, 1):
        for offset_1 in nl.affine_range(0, 2, 1):
            for offset_2 in nl.affine_range(0, 100, 100):
                # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_h, tile_q in hl.tile(
                # src[test_ap_sentinel_refactor.py:N]:     [num_batches, nheads, L], block_size=[1, 1, None]
                # src[test_ap_sentinel_refactor.py:N]: ):
                indices_2 = nl.ndarray([1, 100], nl.int32, buffer=nl.sbuf)
                nisa.iota(dst=indices_2, pattern=[[1, 100]], offset=offset_2, channel_multiplier=0)
                # src[test_ap_sentinel_refactor.py:N]: starts = offsets[tile_b.begin]
                _nki_sbuf_1 = nl.ndarray([1, 1], nl.int32, buffer=nl.sbuf)
                nisa.memset(_nki_sbuf_1, value=0)
                if offset_0 >= 0 and offset_0 + 1 <= 5:
                    nisa.dma_copy(dst=_nki_sbuf_1, src=offsets[0:1, offset_0:offset_0 + 1])
                # src[test_ap_sentinel_refactor.py:N]: i_h = tile_h.id
                tile_id = offset_1 // 1
                # src[test_ap_sentinel_refactor.py:N]: out[tile_q.index + starts, i_h, :] = x[tile_q.index + starts, i_h, :]
                v_0 = 0
                _row_idx_add = nl.ndarray([1, 100], nl.int32, buffer=nl.sbuf)
                _row_idx_scalar_bcast = nl.ndarray([1, 100], nl.int32, buffer=nl.sbuf)
                _row_idx_scalar_bcast = nl.broadcast_to(_nki_sbuf_1, shape=(1, 100))
                nisa.tensor_tensor(dst=_row_idx_add, data1=indices_2, data2=_row_idx_scalar_bcast, op=nl.add)
                _ig_cast_in = nl.ndarray([1, 100], nl.float32, buffer=nl.sbuf)
                nisa.activation(dst=_ig_cast_in, op=nl.copy, data=_row_idx_add)
                _ig_tr_psum = nl.ndarray([100, 1], nl.float32, buffer=nl.psum)
                nisa.nc_transpose(dst=_ig_tr_psum, data=_ig_cast_in)
                _ig_tr_sbuf = nl.ndarray([100, 1], nl.uint32, buffer=nl.sbuf)
                nisa.tensor_scalar(dst=_ig_tr_sbuf, data=_ig_tr_psum, op0=nl.add, operand0=0.0)
                _3d_flat_idx = nl.ndarray([100, 1], nl.uint32, buffer=nl.sbuf)
                nisa.tensor_copy(dst=_3d_flat_idx, src=_ig_tr_sbuf)
                nisa.tensor_scalar(dst=_3d_flat_idx, data=_3d_flat_idx, op0=nl.multiply, operand0=2, op1=None)
                nisa.tensor_scalar(dst=_3d_flat_idx, data=_3d_flat_idx, op0=nl.add, operand0=tile_id, op1=None)
                _nki_sbuf_2 = nl.ndarray([100, 16], nl.float32, buffer=nl.sbuf)
                nisa.memset(_nki_sbuf_2, value=0)
                _ig_flat_vec = nl.ndarray([100, 1], nl.uint32, buffer=nl.sbuf)
                nisa.tensor_scalar(dst=_ig_flat_vec, data=_3d_flat_idx, op0=nl.multiply, operand0=16, op1=None)
                if 0 >= 0 and 16 <= 16:
                    nisa.dma_copy(dst=_nki_sbuf_2, src=x.reshape([200 * 16, 1]).ap(pattern=[[1, 100], [1, 16]], vector_offset=_ig_flat_vec, indirect_dim=0), oob_mode=nisa.oob_mode.skip)
                v_1 = 0
                _ss_iota = nl.ndarray([1, 100], nl.int32, buffer=nl.sbuf)
                nisa.iota(dst=_ss_iota, pattern=[[1, 100]], offset=_nki_sbuf_1 + offset_2, channel_multiplier=0)
                _ss_scaled = nl.ndarray([1, 100], nl.int32, buffer=nl.sbuf)
                nisa.tensor_scalar(dst=_ss_scaled, data=_ss_iota, op0=nl.multiply, operand0=2, op1=None)
                _ss_row = nl.ndarray([1, 100], nl.int32, buffer=nl.sbuf)
                nisa.tensor_scalar(dst=_ss_row, data=_ss_scaled, op0=nl.add, operand0=offset_1, op1=None)
                _ig_cast_in_1 = nl.ndarray([1, 100], nl.float32, buffer=nl.sbuf)
                nisa.activation(dst=_ig_cast_in_1, op=nl.copy, data=_ss_row)
                _ig_tr_psum_1 = nl.ndarray([100, 1], nl.float32, buffer=nl.psum)
                nisa.nc_transpose(dst=_ig_tr_psum_1, data=_ig_cast_in_1)
                _ig_tr_sbuf_1 = nl.ndarray([100, 1], nl.uint32, buffer=nl.sbuf)
                nisa.tensor_scalar(dst=_ig_tr_sbuf_1, data=_ig_tr_psum_1, op0=nl.add, operand0=0.0)
                nisa.dma_copy(dst=nki_return_buf.ap(pattern=[[16, 100], [1, 16]], offset=0, vector_offset=_ig_tr_sbuf_1, indirect_dim=0), src=_nki_sbuf_2, oob_mode=nisa.oob_mode.skip)
    # src[test_ap_sentinel_refactor.py:N]: def jagged_3d_load(
    # src[test_ap_sentinel_refactor.py:N]:     x: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N]:     offsets: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    return nki_return_buf

def jagged_3d_load(x: torch.Tensor, offsets: torch.Tensor, *, _launcher=_default_nki_launcher):
    # src[test_ap_sentinel_refactor.py:N]: num_batches = offsets.size(0) - 1
    num_batches = offsets.size(0) - 1
    # src[test_ap_sentinel_refactor.py:N]: L = x.size(0)
    L = x.size(0)
    # src[test_ap_sentinel_refactor.py:N]: nheads = x.size(1)
    nheads = x.size(1)
    # src[test_ap_sentinel_refactor.py:N]: out = torch.empty_like(x)
    out = torch.empty_like(x)
    # src[test_ap_sentinel_refactor.py:N]: for tile_b, tile_h, tile_q in hl.tile(
    # src[test_ap_sentinel_refactor.py:N]:     [num_batches, nheads, L], block_size=[1, 1, None]
    # src[test_ap_sentinel_refactor.py:N]: ):
    # src[test_ap_sentinel_refactor.py:N-N]: ...
    out = _launcher(_helion_jagged_3d_load, (1,), offsets, x).reshape([100, 2, 16])
    # src[test_ap_sentinel_refactor.py:N]: return out
    return out

