                if offset_0 >= 0 and offset_0 + 1 <= 5:
                    nisa.dma_copy(dst=_nki_sbuf_1, src=offsets[0:1, offset_0:offset_0 + 1])
                # src[test_ap_sentinel_refactor.py:N]: out[tile_q.index + starts, tile_d] = x[tile_q.index + starts, tile_d]
                v_0 = 0
                _row_idx_add = nl.ndarray([1, 64], nl.int32, buffer=nl.sbuf)
                _row_idx_scalar_bcast = nl.ndarray([1, 64], nl.int32, buffer=nl.sbuf)
                _row_idx_scalar_bcast = nl.broadcast_to(_nki_sbuf_1, shape=(1, 64))
                nisa.tensor_tensor(dst=_row_idx_add, data1=indices_1, data2=_row_idx_scalar_bcast, op=nl.add)
                _ig_cast_in = nl.ndarray([1, 64], nl.float32, buffer=nl.sbuf)
