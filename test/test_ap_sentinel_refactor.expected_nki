from __future__ import annotations

import torch
import nki
import nki.language as nl
import nki.isa as nisa
from helion.runtime import default_nki_launcher as _default_nki_launcher

@nki.jit
def _helion_indirect_gather(idx, x):
    # src[test_ap_sentinel_refactor.py:N]: def indirect_gather(
    # src[test_ap_sentinel_refactor.py:N]:     x: torch.Tensor,
    # src[test_ap_sentinel_refactor.py:N]:     idx: torch.Tensor,
