import torch
import nki
import nki.language as nl
import nki.isa as nisa
from helion.runtime import default_nki_launcher as _default_nki_launcher

@nki.jit
def _helion_strided_gather(w):
    # src[test_ap_sentinel_refactor.py:N]: def strided_gather(w: torch.Tensor, nheads: int) -> torch.Tensor:
    # src[test_ap_sentinel_refactor.py:N]:     S, H, D = w.shape
