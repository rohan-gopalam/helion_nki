                _ig_tr_psum = nl.ndarray([64, 1], nl.float32, buffer=nl.psum)
                nisa.nc_transpose(dst=_ig_tr_psum, data=_ig_cast_in)
                _ig_tr_sbuf = nl.ndarray([64, 1], nl.uint32, buffer=nl.sbuf)
